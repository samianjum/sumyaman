{% load static %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Fee Receipt - {{ payment.receipt_number }}</title>
    <style>
        body { font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; padding: 20px; }
        .receipt { max-width: 400px; margin: 0 auto; border: 1px solid #ddd; padding: 20px; border-radius: 12px; }
        .header { text-align: center; border-bottom: 2px solid #1e293b; padding-bottom: 10px; margin-bottom: 20px; }
        .school-name { font-size: 18px; font-weight: 800; margin: 0; }
        .school-address { font-size: 11px; color: #555; }
        .receipt-title { font-size: 20px; font-weight: 800; margin: 15px 0 5px; }
        .details { margin: 15px 0; }
        .row { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 13px; }
        .label { font-weight: 600; color: #334155; }
        .value { font-weight: 500; }
        .table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 12px; }
        .table th, .table td { border: 1px solid #e2e8f0; padding: 6px; text-align: left; }
        .total { font-size: 16px; font-weight: 800; text-align: right; border-top: 2px solid #000; padding-top: 8px; margin-top: 8px; }
        .footer { text-align: center; font-size: 10px; color: #777; margin-top: 20px; border-top: 1px dashed #ccc; padding-top: 10px; }
        @media print {
            body { margin: 0; padding: 0; }
            .receipt { border: none; padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
<div class="receipt">
    <div class="header">
        <img src="{% if school.logo %}{{ school.logo.url }}{% else %}/static/logo.png{% endif %}" height="50" alt="Logo">
        <div class="school-name">{{ school.name|default:"ARMY PUBLIC SCHOOL & COLLEGE" }}</div>
        <div class="school-address">Okara Cantt, Punjab</div>
        <div class="receipt-title">FEE RECEIPT</div>
    </div>
    <div class="details">
        <div class="row"><span class="label">Receipt No:</span><span class="value">{{ payment.receipt_number }}</span></div>
        <div class="row"><span class="label">Date:</span><span class="value">{{ payment.transaction_date }}</span></div>
        <div class="row"><span class="label">Student Name:</span><span class="value">{{ payment.student.full_name }}</span></div>
        <div class="row"><span class="label">Father Name:</span><span class="value">{{ payment.student.father_name }}</span></div>
        <div class="row"><span class="label">Roll No:</span><span class="value">{{ payment.student.roll_number }}</span></div>
        <div class="row"><span class="label">Class:</span><span class="value">{{ payment.student.student_class }}-{{ payment.student.student_section }}</span></div>
    </div>
    <table class="table">
        <thead><tr><th>Month/Year</th><th>Total Fee</th><th>Paid (this)</th><th>Remaining</th></tr></thead>
        <tbody>
        {% for rec in payment.fee_records.all %}
        <tr>
            <td>{{ rec.month }}/{{ rec.year }}</td>
            <td>₹{{ rec.total_amount }}</td>
            <td>₹{{ rec.paid_amount }}</td>
            <td>₹{{ rec.pending_amount }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="row"><span class="label">Total Paid:</span><span class="value">₹{{ payment.amount }}</span></div>
    <div class="row"><span class="label">Payment Mode:</span><span class="value">{{ payment.get_payment_mode_display }}</span></div>
    {% if payment.remarks %}<div class="row"><span class="label">Remarks:</span><span class="value">{{ payment.remarks }}</span></div>{% endif %}
    <div class="total">Remaining Balance: ₹{{ remaining_total|default:"0.00" }}</div>
    <div class="footer">This is a computer generated receipt – no signature required.<br>Thank you for your payment.</div>
</div>
<script>window.onload = function() { window.print(); };</script>
</body>
</html>

{% extends "hq_admin_custom/base.html" %}
{% block title %}Settings | {{ current_school.name }}{% endblock %}
{% block content %}
<div class="container-fluid py-4">
    <div class="section-title mb-4">
        <h2 class="fw-bold"><i class="fas fa-shield-alt me-2 text-primary"></i>School Control Center</h2>
        <p class="text-muted">Manage your school's identity and administrative security.</p>
    </div>

    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show shadow-sm" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endif %}

    <div class="row g-4">
        <!-- School Branding -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-paint-brush me-2 text-info"></i>Visual Branding</h5>
                </div>
                <div class="card-body p-4">
                    <form method="POST" enctype="multipart/form-data">
                        {% csrf_token %}
                        <input type="hidden" name="action" value="update_branding">
                        <div class="text-center mb-4">
                            <div id="logoPreview" class="mx-auto mb-3 shadow" style="width: 150px; height: 150px; border-radius: 25px; border: 3px solid #eee; background-image: url('{% if current_school.logo %}{{ current_school.logo.url }}{% else %}/static/logo.png{% endif %}'); background-size: cover; background-position: center;"></div>
                            <label class="btn btn-outline-primary btn-sm px-4">
                                Change Logo <input type="file" name="logo" hidden onchange="previewFile()">
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Official School Name</label>
                            <input type="text" name="school_name" class="form-control form-control-lg bg-light border-0" value="{{ current_school.name }}" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm mt-2">Save Global Changes</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Security & Access -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-key me-2 text-danger"></i>Admin Credentials</h5>
                </div>
                <div class="card-body p-4">
                    <form method="POST" id="securityForm">
                        {% csrf_token %}
                        <input type="hidden" name="action" value="update_security">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase">Admin Username</label>
                            <input type="text" name="username" class="form-control border-0 bg-light" value="{{ request.user.username }}" required>
                        </div>

                        <hr class="my-4 opacity-50">

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase">Current Password</label>
                            <input type="password" name="current_password" class="form-control border-0 bg-light" placeholder="Confirm it's you" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase">New Secure Password</label>
                            <input type="password" id="newPass" name="new_password" class="form-control border-0 bg-light" placeholder="New Password" onkeyup="checkRequirements()">
                            
                            <!-- Password Requirements UI -->
                            <div class="p-3 mt-2 rounded bg-dark text-white small" style="--bs-bg-opacity: 0.05;">
                                <div id="req-len" class="mb-1 text-danger"><i class="fas fa-times-circle me-2"></i>At least 10 characters</div>
                                <div id="req-spec" class="mb-1 text-danger"><i class="fas fa-times-circle me-2"></i>At least 2 special symbols (#@$!)</div>
                                <div id="req-num" class="text-danger"><i class="fas fa-times-circle me-2"></i>At least 3 numbers</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase">Re-enter New Password</label>
                            <input type="password" id="confirmPass" name="confirm_password" class="form-control border-0 bg-light" placeholder="Confirm password" onkeyup="checkMatch()">
                            <small id="matchStatus" class="d-none mt-1 fw-bold"></small>
                        </div>

                        <button type="submit" id="secBtn" class="btn btn-danger w-100 py-2 fw-bold shadow-sm" disabled>Update Security (Will Logout)</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


        <!-- Fee Automation Settings -->
        <div class="col-lg-12 mt-4">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-cog me-2 text-primary"></i>Fee Automation Settings</h5>
                </div>
                <div class="card-body p-4">
                    <form method="POST">
                        {% csrf_token %}
                        <input type="hidden" name="action" value="update_fee_settings">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Generation Day</label>
                                <input type="number" name="generation_day" class="form-control" value="{{ fee_settings.generation_day|default:1 }}" min="1" max="31">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Due Date Offset (days)</label>
                                <input type="number" name="due_date_offset" class="form-control" value="{{ fee_settings.due_date_offset|default:15 }}" min="1">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Late Fee Penalty (%)</label>
                                <input type="number" name="late_fee_penalty" class="form-control" value="{{ fee_settings.late_fee_penalty|default:0 }}" step="0.01">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Grace Period (days)</label>
                                <input type="number" name="grace_period_days" class="form-control" value="{{ fee_settings.grace_period_days|default:0 }}" min="0">
                            </div>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-primary px-4">Save Fee Settings</button>
                        </div>
                    </form>
                    <hr class="my-3">
                    <div class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i> Auto‑generation runs daily (cron). Due date = generation day + offset. Late fee applies after due date + grace period.
                    </div>
                </div>
            </div>
        </div>

<script>
function previewFile() {
    const preview = document.getElementById('logoPreview');
    const file = document.querySelector('input[type=file]').files[0];
    const reader = new FileReader();
    reader.onloadend = () => preview.style.backgroundImage = `url(${reader.result})`;
    if (file) reader.readAsDataURL(file);
}

function checkRequirements() {
    const val = document.getElementById('newPass').value;
    const btn = document.getElementById('secBtn');
    
    const isLen = val.length >= 10;
    const isSpec = (val.match(/[!@#$%^&*(),.?":{}|<>]/g) || []).length >= 2;
    const isNum = (val.match(/\d/g) || []).length >= 3;

    updateReq('req-len', isLen);
    updateReq('req-spec', isSpec);
    updateReq('req-num', isNum);

    toggleButton();
}

function updateReq(id, met) {
    const el = document.getElementById(id);
    el.className = met ? 'mb-1 text-success' : 'mb-1 text-danger';
    el.querySelector('i').className = met ? 'fas fa-check-circle me-2' : 'fas fa-times-circle me-2';
}

function checkMatch() {
    const p1 = document.getElementById('newPass').value;
    const p2 = document.getElementById('confirmPass').value;
    const status = document.getElementById('matchStatus');
    
    status.classList.remove('d-none');
    if(p1 === p2 && p1 !== "") {
        status.innerText = "✓ Passwords Match";
        status.className = "text-success d-block small mt-1";
    } else {
        status.innerText = "× Passwords do not match";
        status.className = "text-danger d-block small mt-1";
    }
    toggleButton();
}

function toggleButton() {
    const p1 = document.getElementById('newPass').value;
    const p2 = document.getElementById('confirmPass').value;
    const isLen = p1.length >= 10;
    const isSpec = (p1.match(/[!@#$%^&*(),.?":{}|<>]/g) || []).length >= 2;
    const isNum = (p1.match(/\d/g) || []).length >= 3;
    
    document.getElementById('secBtn').disabled = !(isLen && isSpec && isNum && p1 === p2);
}
</script>
{% endblock %}

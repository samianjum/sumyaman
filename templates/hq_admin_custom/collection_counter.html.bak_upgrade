{% extends 'hq_admin_custom/base.html' %}
{% load static %}
{% block title %}Collection Counter | Fee Management{% endblock %}
{% block extra_head %}<meta name="csrf-token" content="{{ csrf_token }}"><style>.mode-btn.active{background:#1e293b;color:#fff;}</style>{% endblock %}
{% block content %}
<div class="container-fluid p-4">
  <h2 class="fw-bold mb-4"><i class="fas fa-cash-register me-2"></i>Collection Counter</h2>
  <div class="row">
    <div class="col-md-5">
      <div class="card shadow-sm mb-4"><div class="card-body"><input type="text" id="searchStudent" class="form-control form-control-lg" placeholder="Search by Roll, Name, Father CNIC..."><div id="searchResults" class="list-group mt-2"></div></div></div>
      <div id="studentInfo" style="display:none;" class="card shadow-sm mb-4"><div class="card-body"></div></div>
    </div>
    <div class="col-md-7">
      <div id="pendingTable" style="display:none;" class="card shadow-sm mb-4"><div class="card-header bg-white fw-bold">Unpaid Months</div><div class="card-body p-0"><table class="table table-sm mb-0"><thead><tr><th>Month</th><th>Due</th><th>Pending</th><th><input type="checkbox" id="selectAll"></th></tr></thead><tbody id="pendingRows"></tbody></table></div></div>
      <div id="paymentPanel" style="display:none;" class="card shadow-sm"><div class="card-body"><div class="mb-3"><label>Amount Received</label><input type="number" id="amountPaid" class="form-control" step="0.01"></div><div class="mb-3"><label>Payment Mode</label><div class="d-flex gap-2"><button class="mode-btn btn btn-outline-secondary" data-mode="cash">Cash</button><button class="mode-btn btn btn-outline-secondary" data-mode="bank_transfer">Bank</button><button class="mode-btn btn btn-outline-secondary" data-mode="cheque">Cheque</button><button class="mode-btn btn btn-outline-secondary" data-mode="online">Online</button></div></div><div class="mb-3"><label>Reference/Remarks</label><input type="text" id="remarks" class="form-control"></div><div class="d-flex gap-2"><button id="collectBtn" class="btn btn-success w-50">Collect & Print</button><button id="siblingBtn" class="btn btn-outline-info w-50">Pay for Siblings</button></div></div></div>
    </div>
  </div>
</div>
<div class="modal fade" id="siblingModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Family Payment</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="siblingList"></div><div class="modal-footer"><button class="btn btn-primary" id="paySiblingsBtn">Pay Selected</button></div></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const csrf = document.querySelector('[name=csrf-token]').content;
let currentStudent = null, pendingRecords = [], totalPending = 0;
const searchInput = document.getElementById('searchStudent');
let searchTimeout;
searchInput.addEventListener('input', function(){ clearTimeout(searchTimeout); const q=this.value.trim(); if(q.length<2) return; searchTimeout=setTimeout(()=>{ fetch(`/s/{{ school_slug }}/fee/student/search/?q=${encodeURIComponent(q)}`).then(r=>r.json()).then(data=>{ let html=''; data.results.forEach(s=>{ html+=`<button class="list-group-item list-group-item-action" onclick="selectStudent(${s.id})"><strong>${s.full_name}</strong> (${s.roll_number})<br><small>Pending: ₹${s.pending_total}</small></button>`; }); document.getElementById('searchResults').innerHTML=html; }); },300); });
function selectStudent(id){ fetch(`/s/{{ school_slug }}/fee/student/pending/?student_id=${id}`).then(r=>r.json()).then(data=>{ currentStudent=id; pendingRecords=data.pending; totalPending=pendingRecords.reduce((s,r)=>s+parseFloat(r.pending_amount),0); document.getElementById('studentInfo').style.display='block'; document.getElementById('pendingTable').style.display='block'; document.getElementById('paymentPanel').style.display='block'; document.getElementById('studentInfo').innerHTML=`<h5>${data.student_name}</h5><p class="text-danger">Total Pending: ₹${totalPending.toFixed(2)}</p>`; let rows=''; pendingRecords.forEach(r=>{ rows+=`<tr><td>${r.month}/${r.year}</td><td>₹${r.total_amount}</td><td>₹${r.pending_amount}</td><td><input type="checkbox" class="monthCheck" data-id="${r.id}" data-amount="${r.pending_amount}"></td></tr>`; }); document.getElementById('pendingRows').innerHTML=rows; document.getElementById('amountPaid').value=totalPending; document.getElementById('selectAll').onclick=function(){ document.querySelectorAll('.monthCheck').forEach(cb=>cb.checked=this.checked); }; });}
let selectedMode='cash'; document.querySelectorAll('.mode-btn').forEach(btn=>{ btn.addEventListener('click',function(){ document.querySelectorAll('.mode-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active'); selectedMode=this.dataset.mode; }); }); document.querySelector('.mode-btn').classList.add('active');
document.getElementById('collectBtn').addEventListener('click',function(){ let amount=document.getElementById('amountPaid').value; let remarks=document.getElementById('remarks').value; fetch('/s/{{ school_slug }}/fee/collect/',{method:'POST',headers:{'Content-Type':'application/json','X-CSRFToken':csrf},body:JSON.stringify({student_id:currentStudent,amount:amount,payment_mode:selectedMode,remarks:remarks})}).then(r=>r.json()).then(data=>{ if(data.success){ Swal.fire({title:'Receipt Generated',html:data.receipt_html,showCloseButton:true}).then(()=>location.reload()); } else Swal.fire('Error',data.error,'error'); }); });
document.getElementById('siblingBtn').addEventListener('click',function(){ if(!currentStudent) return; fetch(`/s/{{ school_slug }}/fee/sibling-search/?father_cnic=XXX`).then(r=>r.json()).then(data=>{ let html='<div class="list-group">'; data.siblings.forEach(s=>{ html+=`<label class="list-group-item"><input type="checkbox" value="${s.id}"> ${s.full_name} (${s.roll_number}) - Pending: ₹${s.pending_total}</label>`; }); html+='</div>'; document.getElementById('siblingList').innerHTML=html; new bootstrap.Modal(document.getElementById('siblingModal')).show(); }); });
document.getElementById('paySiblingsBtn').addEventListener('click',function(){ let selected=[]; document.querySelectorAll('#siblingList input:checked').forEach(cb=>selected.push(cb.value)); if(selected.length===0) return; let amount=prompt('Total amount to pay for selected siblings:'); fetch('/s/{{ school_slug }}/fee/family-pay/',{method:'POST',headers:{'Content-Type':'application/json','X-CSRFToken':csrf},body:JSON.stringify({student_ids:selected,amount:amount,payment_mode:selectedMode})}).then(r=>r.json()).then(data=>{ Swal.fire('Success',`Paid ₹${data.total_paid}`, 'success'); location.reload(); }); });
</script>
{% endblock %}

{% extends 'hq_admin_custom/base.html' %}
{% block content %}
<div class="container-fluid p-4">
  <h2 class="fw-bold mb-4"><i class="fas fa-cogs me-2"></i>Automation Settings</h2>
  <form method="post" class="card shadow-sm p-4">
    {% csrf_token %}
    <div class="row mb-3"><div class="col-md-4"><label>Generation Day of Month</label><input type="number" name="generation_day" class="form-control" value="{{ settings.generation_day }}" min="1" max="31"></div><div class="col-md-4"><label>Due Date Offset (days)</label><input type="number" name="due_date_offset" class="form-control" value="{{ settings.due_date_offset }}"></div><div class="col-md-4"><label>Late Fee Penalty (%)</label><input type="number" step="0.01" name="late_fee_penalty" class="form-control" value="{{ settings.late_fee_penalty }}"></div></div>
    <div class="row mb-3"><div class="col-md-4"><label>Grace Period (days)</label><input type="number" name="grace_period_days" class="form-control" value="{{ settings.grace_period_days }}"></div><div class="col-md-4"><label>Penalty Type</label><select name="penalty_type" class="form-select"><option {% if settings.penalty_type == 'percentage' %}selected{% endif %}>percentage</option><option {% if settings.penalty_type == 'fixed' %}selected{% endif %}>fixed</option></select></div><div class="col-md-4"><label>Penalty Amount/Fixed</label><input type="number" step="0.01" name="penalty_amount" class="form-control" value="{{ settings.penalty_amount }}"></div></div>
    <div class="row mb-3"><div class="col-md-4"><label>Max Penalty (₹)</label><input type="number" step="0.01" name="max_penalty" class="form-control" value="{{ settings.max_penalty }}"></div><div class="col-md-4"><label>Pro-rata Rule</label><select name="pro_rata_type" class="form-select"><option {% if settings.pro_rata_type == 'full' %}selected{% endif %}>full month</option><option {% if settings.pro_rata_type == 'half' %}selected{% endif %}>half month</option><option {% if settings.pro_rata_type == 'daily' %}selected{% endif %}>daily</option></select></div><div class="col-md-4"><div class="form-check mt-4"><input type="checkbox" name="notify_email" class="form-check-input" {% if settings.notify_email %}checked{% endif %}><label class="form-check-label">Send Email Reminders</label></div></div></div>
    <div class="mt-4"><button type="submit" class="btn btn-primary px-4">Save Settings</button></div>
  </form>
  <div class="card mt-4"><div class="card-header">Manual Fee Generation</div><div class="card-body"><form method="post" action="{% url 'manual_fee_generation' school_slug %}">{% csrf_token %}<div class="row"><div class="col"><input type="number" name="year" placeholder="Year" class="form-control"></div><div class="col"><input type="number" name="month" placeholder="Month (1-12)" class="form-control"></div><div class="col"><button type="submit" class="btn btn-warning">Generate Now</button></div></div></form></div></div>
</div>
{% endblock %}
